# Solo servidor: origen del backend. src/proxy.ts reescribe /api/v1/* a ${API_ORIGIN}/v1/*
# (P-1), así la cookie de renovación es de primera parte. Obligatoria sin mocks y al construir.
# Desarrollo: https://136.243.223.39.sslip.io
API_ORIGIN=

# Solo servidor (nunca NEXT_PUBLIC_): firma la IP del cliente para el backend (O1-OPS-1).
# El mismo valor que PROXY_SHARED_SECRET del backend de ese entorno. Vacía = sin firma.
PROXY_SHARED_SECRET=

# 1 = arranca MSW en el navegador (intercepta /api/v1/*) y sirve los datos de
# @drinks-on-chain/mocks. Con 1 no hace falta API_ORIGIN.
NEXT_PUBLIC_MOCKS=1

# Otros sitios del ecosistema (enlaces cruzados). Vacío = el enlace no se muestra.
NEXT_PUBLIC_URL_LANDING=https://drinks-on-chain-landing.vercel.app
NEXT_PUBLIC_URL_BODEGAS=https://drinks-on-chain-bodegas.vercel.app
NEXT_PUBLIC_URL_APP=
# ERP de las bodegas: "Abrir el ERP" para quien también es miembro de una bodega.
NEXT_PUBLIC_URL_ERP=http://localhost:3002
# Enlaces "Escribir por WhatsApp" de la lista de espera. Vacío = https://wa.me
NEXT_PUBLIC_URL_WHATSAPP=

# Cloudflare Turnstile (recuperar contraseña). Vacío = sin widget: se envía el token de prueba
# que aceptan las claves secretas de prueba de Turnstile (desarrollo y mocks).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Módulos de otras olas, ocultos en el menú hasta que existan (1 = visible).
NEXT_PUBLIC_FLAG_PICKUP_POINTS=0
NEXT_PUBLIC_FLAG_SUPPORT=0
NEXT_PUBLIC_FLAG_ORDERS=0
